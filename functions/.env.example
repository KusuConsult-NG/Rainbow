# ── Legacy Firebase backend — audit finding C-6 ──────────────────────────────
#
# This stack is slated for removal. While it exists it is deployable source, and
# two of its exports are PUBLIC HTTP endpoints running with admin privileges.
# Both now fail closed without the secrets below.
#
# ⚠️  Setting these does NOT close C-6. Source changes do not reach a live Cloud
#     Function until someone redeploys. Run this first:
#         firebase functions:list --project rainbow-97f1e
#     and delete anything still there. See E2E_AUDIT_REPORT.md C-6.

# Shared secret the SMS gateway must send as X-Rainbow-Gateway-Auth.
# Unset => smsWebhook returns 503 and accepts nothing.
RAINBOW_SMS_GATEWAY_SECRET=

# Mock-data seeding. Both are required, and seeding must never be enabled in
# production: it writes CRITICAL alerts, three of them flagged DURESS.
RAINBOW_ALLOW_SEED=false
RAINBOW_SEED_SECRET=
