rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isHQ() {
      return isAuth() && (
        (request.auth.token.email != null && request.auth.token.email.matches('.*@operationrainbow\\.plateau\\.gov\\.ng')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'HQ_OFFICER')
      );
    }
    function isStaff() {
      return isAuth() && (
        (request.auth.token.email != null && request.auth.token.email.matches('.*@operationrainbow\\.plateau\\.gov\\.ng')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['HQ_OFFICER','LGA_OFFICER','WARD_OFFICER','POLLING_UNIT_OFFICER', 'AGENT'])
      );
    }

    // ─── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isStaff());
      allow create: if isAuth();
      allow update: if isAuth() && (request.auth.uid == userId || isHQ());
      allow delete: if isHQ();

      match /emergency_contacts/{contactId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }
    }

    // ─── Alerts (RBAC & Jurisdictional Isolation) ──────────────────────────────
    match /alerts/{alertId} {
      function getUser() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      allow create: if isAuth();
      
      allow read: if isAuth() && (
        resource.data.reportedBy == request.auth.uid || 
        isHQ() || 
        (isStaff() && (
          (getUser().role == 'LGA_OFFICER' && resource.data.geo_lga == getUser().lga) ||
          (getUser().role == 'WARD_OFFICER' && resource.data.geo_ward == getUser().ward) ||
          (getUser().role == 'POLLING_UNIT_OFFICER' && resource.data.geo_pu == getUser().pu)
        ))
      );

      // HQ Override: HQ can update any alert. 
      // Tiered Officers: Can only update if alert is assigned to their tier AND in their location.
      allow update: if isStaff() && (
        isHQ() ||
        (
          getUser().role == 'LGA_OFFICER' && 
          resource.data.assigned_to == 'LGA' && 
          resource.data.geo_lga == getUser().lga
        ) ||
        (
          getUser().role == 'WARD_OFFICER' && 
          resource.data.assigned_to == 'WARD' && 
          resource.data.geo_ward == getUser().ward
        ) ||
        (
          getUser().role == 'POLLING_UNIT_OFFICER' && 
          resource.data.assigned_to == 'POLLING_UNIT' && 
          resource.data.geo_pu == getUser().pu
        )
      );

      allow delete: if false; // Immutable audit trail
    }

    // ─── Tracking ──────────────────────────────────────────────────────────────
    // PRD §8: Only authenticated apps can write; only staff can read.
    match /tracking/{document=**} {
      allow create: if isAuth();
      allow read, update, delete: if isStaff();
    }

    // ─── Broadcasts ────────────────────────────────────────────────────────────
    match /broadcasts/{document=**} {
      allow read: if isAuth();
      allow write: if isStaff();
    }

    // ─── System Configuration ──────────────────────────────────────────────────
    // PRD §11 + §12: HQ controls escalation timing and notification rules.
    match /system/{document=**} {
      allow read: if isAuth();
      allow write: if isHQ();
    }

    // PRD legacy path — keep for backwards compat
    match /system_config/{document=**} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ─── Audit Logs ────────────────────────────────────────────────────────────
    // PRD §11: Every system action is recorded. No edits or deletes ever.
    match /audit_logs/{document=**} {
      allow create: if isAuth();
      allow read: if isStaff();
      allow update, delete: if false; // immutable
    }
  }
}
