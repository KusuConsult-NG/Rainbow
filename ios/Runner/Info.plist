	<!-- Location Permissions — Required for SOS GPS tracking -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Operation Rainbow needs your location to dispatch emergency services to your exact position during an SOS alert.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Operation Rainbow tracks your location in the background to provide continuous protection and enable real-time emergency response even when the app is not active.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Operation Rainbow tracks your location in the background so emergency services can reach you even if your screen is off during an incident.</string>

	<!-- Microphone — Required for future duress voice detection -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Operation Rainbow may use your microphone for voice-activated emergency alerts and duress detection features.</string>

	<!-- Speech Recognition — Required for voice report dictation -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Operation Rainbow uses speech recognition to transcribe your spoken voice reports and chat messages into text.</string>

	<!-- Camera & Photo Library — Required for adding incident evidence -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Operation Rainbow uses Bluetooth to pass sealed emergency alerts between nearby phones when there is no mobile network, so an SOS can still reach HQ. Phones that carry an alert cannot read it.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Operation Rainbow uses Bluetooth to pass sealed emergency alerts between nearby phones when there is no mobile network, so an SOS can still reach HQ. Phones that carry an alert cannot read it.</string>
	<key>NSCameraUsageDescription</key>
	<string>Operation Rainbow needs access to your camera so you can take photos or videos of incidents to submit as evidence.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Operation Rainbow needs access to your photo library so you can select photos or videos of incidents to submit as evidence.</string>

	<!-- Biometrics -->
	<key>NSFaceIDUsageDescription</key>
	<string>Operation Rainbow needs Face ID to securely authenticate staff personnel without manual PIN entry.</string>

	<!-- Background Modes — Required for location tracking during active emergency -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
