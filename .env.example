# ── Operation Rainbow — mobile app configuration ─────────────────────────────
# Copy to `.env` at the repo root. `pubspec.yaml` declares `.env` as a Flutter
# ASSET, so the file must exist or `flutter build`/`flutter test` fails outright.
#
# ⚠️  SECURITY: Flutter assets are stored verbatim inside the APK/IPA and extract
# with `unzip`. Anything here is readable by anyone who downloads the app. Treat
# every value below as public. Server-side secrets do not belong in this file —
# they belong behind an authenticated backend endpoint. See E2E_AUDIT_REPORT.md H-3.

# ── Emergency PINs
# There are none here any more. SAFE_PIN and DURESS_PIN used to live in this
# file — a Flutter asset, shipped verbatim inside every APK — so every install
# shared one duress code that anyone who unzipped the app could read. PINs are
# now per-user and verified on the server (supabase/migrations/
# 20260902000000_per_user_emergency_pins.sql); users set them at onboarding or
# under Settings → Emergency PIN. Nothing PIN-related belongs in this file.

# ── HQ backend
# Base URL of the Next.js dashboard, e.g. https://hq.operationrainbow.example.
# A hostname, not a credential — safe to bundle. When unset, the SOS escalation
# SMS is skipped; the alert row is still written.
HQ_API_BASE_URL=

# ── The two offline channels
# Both exist so a report raised with no data connection still reaches HQ. Both
# stay OFF until these are set, and both are safe to bundle: a destination number
# and a public key are not credentials. The per-device key that authenticates each
# message is issued by the server at sign-in and kept in the Keystore/Keychain —
# never here. See docs/OFFLINE_CHANNELS_DESIGN.md.

# Where an SMS-borne alert is sent: the shortcode or long number the HQ gateway
# receives on. Unset means no SMS fallback — a message with nowhere to go costs
# money and reaches nobody.
SMS_EMERGENCY_SHORTCODE=

# HQ's mesh PUBLIC key: a compressed P-256 point, 33 bytes as 66 hex characters.
# It can only seal, never open; the private half lives on the HQ server and
# nowhere else. Generate the pair offline with
#   MESH_KEYGEN=1 flutter test test/mesh_keygen_test.dart
# A malformed or half-length value is REFUSED rather than used, because a phone
# that believes it has a working channel is worse than one that knows it has not.
MESH_HQ_PUBLIC_KEY=

# ── Map tiles
# Optional. Unset means OpenStreetMap, which needs no key.
#
# CARTO's dark basemap was hardcoded here and now answers unauthenticated
# requests with a placeholder tile reading "API key required", so every map in
# the app rendered as a grid of watermarks. OSM is light, and the app darkens it
# locally with a colour filter.
#
# OSM's tile policy is aimed at modest use. A statewide service in daily
# operation belongs on a keyed provider or its own tile server; set that here and
# nothing in the code changes. Must be https and contain {z}, {x} and {y}.
MAP_TILE_URL=

# ── Media upload (Cloudinary)
# Use an UNSIGNED upload preset. Never ship CLOUDINARY_API_SECRET in the app —
# signing must happen on a server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ── Demo / test accounts (non-production builds)
DEMO_CITIZEN_EMAIL=

# ── No credential belongs in THIS file ──────────────────────────────────────
#
# pubspec.yaml declares `.env` as a Flutter ASSET, so whatever is in it ships
# verbatim inside the APK and extracts with `unzip` (E2E_AUDIT_REPORT.md H-3).
# A password here is a published password.
#
# REMOVED:
#   AGENT_DEFAULT_PASS   one password shared by every staff account, which
#                        AuthService.signInWithAccessCode used to sign in as
#                        `<code>@operationrainbow.plateau.gov.ng`. The access
#                        code was only the email local-part — a username — so
#                        anybody with the APK and an officer's code could sign
#                        in as that officer. Staff now use signInWithBadge with
#                        their own password, and the screen asks for one.
#   DEMO_CITIZEN_PASS    a real account with a real password. The code path is
#                        compiled out of release builds, but the value was
#                        readable in the artifact whether or not anything read
#                        it. Set it in a LOCAL .env if you need the debug
#                        bypass; it is not a template value.
#
# CI fails on any name here matching PASS/PASSWORD/PIN/SECRET/TOKEN.
