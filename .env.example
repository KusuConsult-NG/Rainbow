# ── Operation Rainbow — mobile app configuration ─────────────────────────────
# Copy to `.env` at the repo root. `pubspec.yaml` declares `.env` as a Flutter
# ASSET, so the file must exist or `flutter build`/`flutter test` fails outright.
#
# ⚠️  SECURITY: Flutter assets are stored verbatim inside the APK/IPA and extract
# with `unzip`. Anything here is readable by anyone who downloads the app. Treat
# every value below as public. Server-side secrets do not belong in this file —
# they belong behind an authenticated backend endpoint. See E2E_AUDIT_REPORT.md H-3.

# ── Safety-critical. No code fallback exists for these (deliberately).
# AppConfig.validate() reports them as missing at startup and asserts in debug.
#
# NOTE: these are currently build-time constants shared by EVERY install. The
# duress PIN in particular should be per-user and verified server-side — a shared,
# extractable duress code is defeatable by anyone who reads the binary.
SAFE_PIN=
DURESS_PIN=
HMAC_SECRET=

# ── Emergency dispatch
SOS_PHONE=

# ── SMS (Termii). Leave blank to run in simulated mode (no SMS is sent).
TERMII_API_KEY=

# ── Media upload (Cloudinary)
# Use an UNSIGNED upload preset. Never ship CLOUDINARY_API_SECRET in the app —
# signing must happen on a server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ── Demo / test accounts (non-production builds)
DEMO_CITIZEN_EMAIL=
DEMO_CITIZEN_PASS=
AGENT_DEFAULT_PASS=
