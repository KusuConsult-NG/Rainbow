# ── Operation Rainbow — HQ Dashboard configuration ───────────────────────────
# Copy to `.env.local` and fill in. Nothing here has a hardcoded fallback:
# a missing value fails loudly at startup instead of degrading silently.

# Public — safe to ship to the browser (Supabase anon key is public by design).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only. Never prefix with NEXT_PUBLIC_.
# Bypasses all Row Level Security. If this ever reaches a browser bundle, rotate it.
SUPABASE_SERVICE_ROLE_KEY=

# SMS (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=RainbowHQ

# Push (OneSignal)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Shared secret sent as X-Rainbow-Auth on outbound agency webhooks
RAINBOW_WEBHOOK_SECRET=

# Inter-agency liaison contacts
POLICE_LIAISON_PHONE=
POLICE_WEBHOOK_URL=
ARMY_LIAISON_PHONE=
ARMY_WEBHOOK_URL=
DSS_LIAISON_PHONE=
DSS_WEBHOOK_URL=
NSCDC_LIAISON_PHONE=
NSCDC_WEBHOOK_URL=
FRSC_LIAISON_PHONE=
FRSC_WEBHOOK_URL=
AMOTEKUN_LIAISON_PHONE=

# Development only — quick-fill login presets are compiled out of production builds.
NEXT_PUBLIC_DEV_DEMO_PIN=
