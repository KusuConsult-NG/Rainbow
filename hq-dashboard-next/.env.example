# ── Operation Rainbow — HQ Dashboard configuration ───────────────────────────
# Copy to `.env.local` and fill in. Nothing here has a hardcoded fallback:
# a missing value fails loudly at startup instead of degrading silently.

# Public — safe to ship to the browser (Supabase anon key is public by design).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only. Never prefix with NEXT_PUBLIC_.
# Bypasses all Row Level Security. If this ever reaches a browser bundle, rotate it.
SUPABASE_SERVICE_ROLE_KEY=

# SMS (Termii) — SECRET, server only.
# This key used to live in the mobile app's bundled `.env`, which ships inside the
# APK. It belongs here and nowhere else. See E2E_AUDIT_REPORT.md H-3.
TERMII_API_KEY=
TERMII_SENDER_ID=RainbowHQ

# Where citizen SOS escalation SMS is sent. Server-side on purpose: if the mobile
# app could choose the recipient, /api/sos/dispatch-sms would be an authenticated
# open SMS relay billed to the Termii account above.
SOS_DISPATCH_PHONE=

# Push (OneSignal)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Shared secret sent as X-Rainbow-Auth on outbound agency webhooks
RAINBOW_WEBHOOK_SECRET=

# Inter-agency liaison contacts
POLICE_LIAISON_PHONE=
POLICE_WEBHOOK_URL=
ARMY_LIAISON_PHONE=
ARMY_WEBHOOK_URL=
DSS_LIAISON_PHONE=
DSS_WEBHOOK_URL=
NSCDC_LIAISON_PHONE=
NSCDC_WEBHOOK_URL=
FRSC_LIAISON_PHONE=
FRSC_WEBHOOK_URL=
AMOTEKUN_LIAISON_PHONE=

# Development only — quick-fill login presets are compiled out of production builds.
NEXT_PUBLIC_DEV_DEMO_PIN=
