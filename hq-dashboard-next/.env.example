# ── Operation Rainbow — HQ Dashboard configuration ───────────────────────────
# Copy to `.env.local` and fill in. Nothing here has a hardcoded fallback:
# a missing value fails loudly at startup instead of degrading silently.

# Public — safe to ship to the browser (Supabase anon key is public by design).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only. Never prefix with NEXT_PUBLIC_.
# Bypasses all Row Level Security. If this ever reaches a browser bundle, rotate it.
SUPABASE_SERVICE_ROLE_KEY=

# SMS (Termii) — SECRET, server only.
# This key used to live in the mobile app's bundled `.env`, which ships inside the
# APK. It belongs here and nowhere else. See E2E_AUDIT_REPORT.md H-3.
TERMII_API_KEY=
TERMII_SENDER_ID="OE Alert"

# Where citizen SOS escalation SMS is sent. Server-side on purpose: if the mobile
# app could choose the recipient, /api/sos/dispatch-sms would be an authenticated
# open SMS relay billed to the Termii account above.
SOS_DISPATCH_PHONE=

# Gemini AI — SECRET, server only. NOT NEXT_PUBLIC_.
# It was `NEXT_PUBLIC_GEMINI_API_KEY`, which Next.js inlines into the client
# bundle, so any deployment that set it served the key to every dashboard
# visitor — and it travelled in the URL query string, so also into browser
# history, Referer headers and proxy logs. Read only by /api/ai/analyze.
# Leave blank to disable AI features; triage falls back to its rule-based engine.
GEMINI_API_KEY=

# ── The two offline channels ─────────────────────────────────────────────────
# Both exist so a phone with no data connection can still reach HQ. Both are
# OFF until these values are set, and both refuse traffic rather than accepting
# it unauthenticated — the Firebase `smsWebhook` they replace accepted anything
# that reached its URL. See docs/OFFLINE_CHANNELS_DESIGN.md.

# Shared secret the SMS gateway sends as X-Gateway-Secret to /api/sms/inbound.
# Unset means the endpoint refuses every message. It authenticates the GATEWAY;
# each message is separately authenticated by the sending handset's device key,
# so a caller who obtains this still cannot forge an alert.
SMS_GATEWAY_SECRET=

# HQ's mesh private key: 32 bytes as 64 hex characters. SECRET, server only.
#
# This is the most sensitive value in the deployment. It opens every mesh alert
# ever sent, including past ones, because the ephemeral halves are discarded by
# the sending handset. Generate it OFFLINE and keep the private half here and
# nowhere else:
#
#   MESH_KEYGEN=1 flutter test test/mesh_keygen_test.dart   # prints a fresh pair
#
# (Without MESH_KEYGEN=1 the tool deliberately prints nothing, so CI logs never
# hold key material.) This value is the PRIVATE half: 64 hex characters.
#
# Only the PUBLIC half (66 hex characters) ships to handsets, as
# MESH_HQ_PUBLIC_KEY in the app's bundled .env, so rotating it needs an app
# release; see docs/OFFLINE_CHANNELS_DESIGN.md. Unset means /api/mesh/ingest
# refuses all traffic.
MESH_HQ_PRIVATE_KEY=

# Map tiles — optional, PUBLIC (it is a URL, not a credential).
# Unset means OpenStreetMap, which needs no key; the console darkens it with a
# CSS filter for the dark theme. CARTO was hardcoded here and now serves an
# "API key required" placeholder tile to unauthenticated callers.
NEXT_PUBLIC_MAP_TILE_URL=

# Push (OneSignal)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Shared secret sent as X-Rainbow-Auth on outbound agency webhooks
RAINBOW_WEBHOOK_SECRET=

# Inter-agency liaison contacts
POLICE_LIAISON_PHONE=
POLICE_WEBHOOK_URL=
ARMY_LIAISON_PHONE=
ARMY_WEBHOOK_URL=
DSS_LIAISON_PHONE=
DSS_WEBHOOK_URL=
NSCDC_LIAISON_PHONE=
NSCDC_WEBHOOK_URL=
FRSC_LIAISON_PHONE=
FRSC_WEBHOOK_URL=
# Operation Safe Haven, the joint task force covering Plateau. This used to say
# AMOTEKUN, which is a South-West outfit with no presence in this state.
OPSH_LIAISON_PHONE=
OPSH_WEBHOOK_URL=

# OneSignal's two credential generations do NOT take the same Authorization
# scheme: a legacy REST API key wants `Basic <key>` and an `os_v2_*` key wants
# `Key <key>`. Four call sites in this repo hardcoded one or the other and two of
# them disagreed, so at least one had never authenticated.
#
# Leave this BLANK and the scheme is guessed from the key's shape, with the other
# tried once if the first is refused — so it works either way and logs which to
# set. Set it to Basic or Key to skip that retry.
ONESIGNAL_AUTH_SCHEME=

# ── USSD reporting ──────────────────────────────────────────────────────────
# Reporting from a handset that cannot make a call. See docs/USSD.md.
#
# The shared secret the aggregator sends as `x-gateway-secret`, compared in
# constant time. WITHOUT IT THE ENDPOINT REFUSES EVERY REQUEST, on purpose: an
# open USSD endpoint lets anybody inject an emergency with a forged MSISDN, which
# removes the one thing this channel's trust rests on — that the CARRIER asserted
# the number.
USSD_GATEWAY_SECRET=
# AT_TEXT (default) for the `CON `/`END ` plain-text convention, or JSON.
USSD_REPLY_FORMAT=

# Development only — quick-fill login presets are compiled out of production builds.
NEXT_PUBLIC_DEV_DEMO_PIN=
