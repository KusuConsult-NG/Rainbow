/android/app/release

# Environment secrets — never commit
.env
*.env
!.env.example

# Firebase config — contains API keys
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Temporary Agent Brain & Scratch Artifacts
brain/
scratch/
*.txt
.firebase/

# ── Added during the E2E audit ────────────────────────────────────────────────
# Dependencies must never be committed: functions/node_modules alone was 13,306
# tracked files / 116 MB.
node_modules/
**/node_modules/

# Build output. The legacy Vite console (hq-dashboard/) is gone, but its
# committed `dist/` — a bundle with a live Firebase API key baked in — is why
# build output is ignored at all.
hq-dashboard-next/.next/
.firebase/

# Credential material. These were committed:
#   GoogleService-Info (3).plist  — Firebase iOS API key
#   hq-002-auth.json              — plaintext "passwordHash": "hq-002"
GoogleService-Info*.plist
hq-00*-auth.json
hq-00*-test.json
users.json

# The local end-to-end run's screenshots (scripts/local_e2e/run.sh). They are
# evidence, not source: CI keeps them as a build artifact and a local run
# regenerates them in about two minutes. 28 MB of committed screenshots is a
# mistake this repository has already made once.
local_e2e_screenshots/
