<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Applied while the process starts, with the OS in dark mode.
         Kept in step with values/styles.xml on purpose: the rebrand changed
         only the light file, so a phone in dark mode still got a transparent
         status bar over the navy splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <!-- The splash is light, so the clock and icons must be dark. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>
    <!-- Applied as soon as the process has started: the colour behind the
         Flutter UI while it initialises, and behind it while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
