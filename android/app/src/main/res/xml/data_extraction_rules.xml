<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing about this app leaves the handset.

     Android 12+ reads this for cloud backup and for device-to-device
     transfer. `android:allowBackup="false"` already covers both; this exists
     so that setting allowBackup back to true cannot quietly re-enable them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
