<?xml version="1.0" encoding="utf-8"?>
<!-- Volume Down x3 while the phone is locked. See VolumeSosAccessibilityService.kt.

     Key events only. No accessibility event types are requested and the window
     content cannot be read, so this service never sees what is on screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/volume_sos_service_description"
    android:summary="@string/volume_sos_service_summary"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0" />
